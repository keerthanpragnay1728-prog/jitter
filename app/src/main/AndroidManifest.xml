<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No SYSTEM_ALERT_WINDOW and no READ_PHONE_STATE.

      Every floating element is a TYPE_ACCESSIBILITY_OVERLAY window owned by
      the accessibility service, which needs no overlay grant. The call panic
      check uses AudioManager.getMode(), which needs no phone grant and also
      catches VoIP.

      No foreground service of any type either. An AccessibilityService is
      already system-bound and persistent.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true"/>
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false"/>

    <!--
      Package visibility for the target picker, and later for the launcher's
      app list. A <queries> element rather than QUERY_ALL_PACKAGES: the
      permission is flagged on review and this is the narrower grant that does
      the same job. Without either, PackageManager returns only our own package
      on API 30+.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!--
          The command bar reports a command as unavailable when nothing on the
          device handles its Intent. Without these entries resolveActivity
          returns null on API 30+ even where a clock app is installed, and
          "$ alarm 6am" would report no clock app on a phone that has one.
        -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER"/>
        </intent>
        <intent>
            <action android:name="android.settings.panel.action.WIFI"/>
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS"/>
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_POLICY_ACCESS_SETTINGS"/>
        </intent>
        <!--
          Digital Wellbeing, for the ledger's "open system wellbeing" link.

          Both entries, because they cover different devices. The package
          entry makes Google's Wellbeing visible, which is what lets
          resolveActivity see its settings Activity by ComponentName; on a
          Pixel that Activity is the only thing that actually starts, and
          the action below fails with "No activity found". The action entry
          covers an OEM implementation in some other package, which a
          package entry naming Google's would miss entirely.

          Without these, resolveActivity returns null on API 30+ even where
          Wellbeing is installed, and the link fell through to raw Usage
          Access on every device.
        -->
        <package android:name="com.google.android.apps.wellbeing"/>
        <intent>
            <action android:name="android.settings.DIGITAL_WELLBEING_SETTINGS"/>
        </intent>
    </queries>

    <application
        android:name=".MolassesApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Molasses">

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- No foreground service. An AccessibilityService is already
             system-bound and persistent; adding an FGS on API 34+ forces a
             `specialUse` type plus a Play justification for no added
             capability. All long-lived work lives in this service's
             lifecycle scope. -->
        <service
            android:name=".monitor.MolassesAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
            <activity
            android:name=".ui.launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
