<?xml version="1.0" encoding="utf-8"?>
<!--
  All display copy lives here, never inline in Kotlin. Two reasons:

  1. It is the Android convention and the only thing that makes the app
     translatable.
  2. It keeps the repo-wide prose rules checkable in one place. With copy
     inline, a grep over *.kt could not tell a user-facing sentence from a
     code comment, and the two have different rules.

  Strings marked translatable="false" are commands, field labels and format
  templates for the debug screen. They are shown on screen but must not be
  reworded or localised.

  Format arguments are all %n$s. Passing an Int to a %d is fine, but passing a
  Double to one throws IllegalFormatConversionException at runtime, and several
  of these take Double thresholds.
-->
<resources>
    <string name="app_name">Jitter</string>
    <string name="a11y_service_label">Jitter progressive friction</string>
    <string name="a11y_service_description">Jitter adds deliberate friction to apps you choose, so that the longer you spend in them the harder they are to keep using. To do that it needs to know two things and only two things: which of your chosen apps is in the foreground, and when you scroll inside one. It uses that to delay your touches and to show a full-screen prompt that asks you to move. It does not read the contents of your screen, it does not read text, and it does not see anything in apps you have not chosen. Nothing it observes leaves your device.</string>

    <!-- Movement gate -->
    <string name="gate_tier">Tier %1$s</string>
    <string name="gate_tier_terminal">Tier %1$s (terminal)</string>
    <string name="gate_minutes_used">%1$s minutes used</string>
    <string name="gate_progress_percent">%1$s%%</string>
    <string name="gate_why">Why am I seeing this?</string>
    <string name="gate_why_intro">You have used this app for %1$s minutes in the current cycle. Clearing this gate unlocks the next five minutes. It does not reset your accumulated time, and it does not reduce the delay on scrolling. Within a cycle the delay only ever grows.</string>
    <string name="gate_why_terminal">You are past twenty minutes, so this gate will return every five minutes until the cycle resets.</string>
    <string name="gate_why_next">The next gate is at %1$s minutes.</string>
    <string name="gate_why_leaving">Pressing HOME or RECENTS will leave this screen. That pauses the gate rather than clearing it. The gate returns when you scroll again.</string>

    <string name="gate_debug_bypass_hint">Debug build. Hold the ring for 2 seconds to bypass.</string>
    <string name="gate_alt_type_this">Type this phrase</string>
    <string name="gate_alt_continue">Continue</string>

    <string name="gate_reason_waiting">Stand up and start walking.</string>
    <string name="gate_reason_need_more_steps">Keep walking. %1$s steps counted.</string>
    <string name="gate_reason_too_slow">A little faster.</string>
    <string name="gate_reason_too_fast">Slower. That is faster than walking.</string>
    <string name="gate_reason_irregular">Keep an even pace.</string>
    <string name="gate_reason_too_regular">That is too even to be walking.</string>
    <string name="gate_reason_not_enough_motion">Not enough movement yet.</string>
    <string name="gate_reason_too_violent">Too much. Walk, do not shake.</string>
    <string name="gate_reason_not_vertical">That is side-to-side, not walking.</string>
    <string name="gate_reason_stationary">The phone is not moving with you.</string>
    <string name="gate_reason_sustaining">Good, keep going.</string>
    <string name="gate_reason_passed">Done.</string>

