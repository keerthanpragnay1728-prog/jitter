    <!-- Settings -->
    <string name="settings_tagline">Your chosen apps are never blocked. The longer you use them in a six-hour cycle, the more the phone feels like it is failing.</string>
    <string name="settings_section_setup">Setup</string>
    <string name="settings_section_ladder">The ladder</string>
    <string name="settings_section_targets">Target apps</string>
    <string name="settings_section_policy">Cycle reset policy</string>
    <string name="settings_section_gate">Movement gate</string>
    <string name="settings_section_safety">Safety</string>
    <string name="settings_safety_body">Banking and UPI apps refuse to run when something is drawn over them, and some warn about accessibility services regardless. Jitter never draws over the apps listed here, and you can silence it entirely for fifteen minutes.</string>
    <string name="settings_pause_start">Pause Jitter (15m)</string>
    <!-- %1$s is minutes, %2$s is zero padded seconds. Both are strings, not
         %d: several strings in this file take Double thresholds and a %d
         given a Double throws IllegalFormatConversionException at runtime, so
         the whole file uses %n$s without exception. -->
    <string name="settings_pause_active">Paused. %1$s:%2$s left.</string>
    <string name="settings_pause_resume">Resume now</string>
    <string name="settings_pause_hint">Stalls and gates stop appearing. Your accumulated time keeps counting, so this does not buy you a clean slate.</string>
    <string name="settings_safety_defaults_title">Always excluded</string>
    <string name="settings_safety_extra_title">Your additions</string>
    <string name="settings_safety_extra_body">One package name per line. A partial name matches everything below it, so com.icicibank covers every app that bank ships. This list cannot cover every Indian bank, so add yours if you see a warning.</string>
    <string name="settings_safety_extra_label">Package prefixes</string>
    <string name="settings_safety_extra_save">Save excluded apps</string>
    <string name="settings_section_try">Try it</string>

    <string name="settings_checklist_done">OK</string>
    <string name="settings_checklist_step">%1$s.</string>

    <string name="settings_perm_a11y_title">Accessibility service</string>
    <string name="settings_perm_a11y_body">Required. Lets Jitter see which app is in front and when you scroll.</string>
    <string name="settings_perm_usage_title">Usage access</string>
    <string name="settings_perm_usage_body">Required. Rebuilds your time if Jitter is killed mid-session.</string>
    <string name="settings_perm_activity_title">Physical activity</string>
    <string name="settings_perm_activity_body">Preferred. Uses the step sensor for the movement gate. Without it the gate falls back to motion analysis.</string>
    <string name="settings_perm_notifications_title">Notifications</string>
    <string name="settings_perm_notifications_body">Optional. Tells you when a cycle resets or a gate is still owed.</string>

    <string name="settings_targets_hint">Scrolling in these apps accumulates time.</string>
    <string name="settings_targets_empty">No launchable apps listed yet.</string>

    <string name="settings_policy_abstinence_title">After 6 hours away</string>
    <string name="settings_policy_abstinence_body">The cycle resets only after six continuous hours with no time in any target app.</string>
    <string name="settings_policy_fixed_title">Every 6 hours (default)</string>
    <string name="settings_policy_fixed_body">The cycle resets six hours after it started, whether or not you kept using the apps.</string>

    <string name="settings_alt_challenge_title">Alternative challenge</string>
    <string name="settings_alt_challenge_body">Replaces the physical gate with a 25-second untimed typing task. For anyone who cannot or should not be made to walk.</string>

    <string name="settings_ladder_normal">0-5 min, normal</string>
    <string name="settings_ladder_terminal">%1$s min+ (terminal), gate every 5 min, %2$s ms stall</string>
    <string name="settings_ladder_tier">%1$s min, gate then %2$s ms stall</string>
    <string name="settings_ladder_note">Clearing a gate unlocks the next five minutes. It never resets your accumulated time and never shortens the stall.</string>

