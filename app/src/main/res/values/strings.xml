<?xml version="1.0" encoding="utf-8"?>
<!--
  All display copy lives here, never inline in Kotlin. Two reasons:

  1. It is the Android convention and the only thing that makes the app
     translatable.
  2. It keeps the repo-wide prose rules checkable in one place. With copy
     inline, a grep over *.kt could not tell a user-facing sentence from a
     code comment, and the two have different rules.

  Strings marked translatable="false" are commands, field labels and format
  templates for the debug screen. They are shown on screen but must not be
  reworded or localised.

  Format arguments are all %n$s. Passing an Int to a %d is fine, but passing a
  Double to one throws IllegalFormatConversionException at runtime, and several
  of these take Double thresholds.
-->
<resources>
    <string name="app_name">Jitter</string>
    <string name="a11y_service_label">Jitter progressive friction</string>
    <string name="a11y_service_description">Jitter adds deliberate friction to apps you choose, so that the longer you spend in them the harder they are to keep using. To do that it needs to know two things and only two things: which of your chosen apps is in the foreground, and when you scroll inside one. It uses that to delay your touches and to show a full-screen prompt that asks you to move. It does not read the contents of your screen, it does not read text, and it does not see anything in apps you have not chosen. Nothing it observes leaves your device.</string>

