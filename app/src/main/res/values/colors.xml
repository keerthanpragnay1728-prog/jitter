<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The "visible tell": a desaturated bar drawn along the top edge while
         the sink is armed. Themeable, deliberately not removable. -->
    <color name="molasses_tell">#FF8C8C96</color>
    <!-- The same marker at the terminal tier. The one hue break in the app,
         and the permanent terminal signal now that Bit's glitch is a burst on
         the crossing rather than a state. Must equal TerminalAlert in
         ui/theme/Color.kt; ShutterTellTest asserts that. -->
    <color name="molasses_tell_terminal">#FFFF5555</color>
    <!-- The launcher icon. Must equal JitterBackground and PhosphorGreen in
         ui/theme/Color.kt; LauncherIconTest asserts both. The icon's shapes
         come from tools/gen-icon.py, which uses the same two values. -->
    <color name="ic_launcher_background">#FF000000</color>
    <color name="phosphor_green">#FF50FA7B</color>
</resources>
