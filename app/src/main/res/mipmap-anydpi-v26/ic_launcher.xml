<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon, for android:icon and android:roundIcon both: the
  launcher applies its own mask, circle or squircle, to one adaptive icon.
  Shapes are generated by tools/gen-icon.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_terminal"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
